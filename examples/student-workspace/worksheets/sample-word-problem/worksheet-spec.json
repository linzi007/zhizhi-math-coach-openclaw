          "type": "condition_filtering_problem",
          "prompt": "小明有18张贴纸，小红有12张贴纸，小刚有9张贴纸。小明比小红多多少张？",
          "answer_prompt": "多",
          "answer_suffix": "张",
          "work_lines": 2,
          "used_conditions": ["小明18张", "小红12张"],
          "unused_conditions": ["小刚9张"],
          "review_status": "model_reviewed",
          "answer_detail": "用小明和小红的数据，`18 - 12 = 6`。小刚的9张是干扰条件。答：多6张。"
        },
        {
          "type": "compare_after_intermediate_problem",
          "prompt": "盒子里有15个红球，蓝球比红球少6个。蓝球有多少个？红球和蓝球一共有多少个？",
          "answer_prompt": "一共",
          "answer_suffix": "个",
          "work_lines": 3,
          "intermediate_quantity": "先求蓝球数量",
          "review_status": "model_reviewed",
          "answer_detail": "先求蓝球：`15 - 6 = 9`；再求一共：`15 + 9 = 24`。答：一共24个。"
        }
      ]
    }
